# ------------------------ Database credentials --------------------------------

# Database user, created by the PostgreSQL container on first start
# (it is the superuser of the container and the user the API connects with)
DB_USER=developer
DB_PASSWORD=9ec2a3d32b383c54ad4126b54d470fdf36fa0f843bca0b90703e6ca598462d4c

# Database name
DB_NAME=retail_sales_db

# Database connection host/port (host port, used by the API from your machine)
DB_HOST=127.0.0.1
DB_PORT=5566

# Port PostgreSQL listens on inside the container
# (must match "Port" in docker/pgadmin/servers.json)
DB_CONTAINER_PORT=5432

# ------------------------------ PgAdmin ---------------------------------------

# PgAdmin credentials
PGADMIN_EMAIL=developer@api.com
PGADMIN_PASSWORD=b2c439621b604ab4e2dafe8d34b648d9e56116beaa2309d0a94d12f02297b258

# Host port (open http://localhost:5050) and port pgAdmin listens on inside the container
PGADMIN_PORT=7070
PGADMIN_CONTAINER_PORT=80